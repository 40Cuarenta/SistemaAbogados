<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.PaginaUsuariosController">
   <children>
      <TableView fx:id="tablaUsuarios" prefHeight="410.0" prefWidth="675.0">
        <columns>
          <TableColumn fx:id="idC" prefWidth="31.0" text="ID" />
          <TableColumn fx:id="userC" prefWidth="62.0" text="USUARIO" />
            <TableColumn fx:id="claveC" prefWidth="56.0" text="CLAVE" />
            <TableColumn fx:id="nombreC" prefWidth="86.0" text="NOMBRE" />
            <TableColumn fx:id="ApellidoC" prefWidth="109.0" text="APELLIDO" />
            <TableColumn fx:id="cedulaC" prefWidth="89.0" text="CEDULA" />
            <TableColumn fx:id="emailC" prefWidth="64.0" text="EMAIL" />
            <TableColumn fx:id="telefonoC" prefWidth="72.0" text="TELEFONO" />
            <TableColumn fx:id="rolC" prefWidth="106.0" text="ROL" />
        </columns>
      </TableView>
      <VBox alignment="CENTER" prefHeight="508.0" prefWidth="184.0" spacing="10.0" style="-fx-background-color: #3A5978;">
         <children>
            <Button fx:id="btnActualizar" mnemonicParsing="false" onMouseClicked="#actualizar" prefHeight="49.0" prefWidth="144.0" text="ACTUALIZAR">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button fx:id="btnAgregar" mnemonicParsing="false" onMouseClicked="#agregar" prefHeight="49.0" prefWidth="142.0" text="AGREGAR">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button fx:id="btnEliminar" mnemonicParsing="false" onMouseClicked="#eliminar" prefHeight="49.0" prefWidth="143.0" text="ELIMINAR">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</HBox>
